<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="playback" default="false" />

  <!-- Node to control enabling/disabling the autonomy system -->
  <node pkg="beliv_vehicle_interface" exec="sys_enable_node.py" name="sys_enable_node" output="screen">
    <param name="use_sim_time" value="false" />
</node>

<!-- DBW -->
<include file="$(find-pkg-share ds_devices)/launch/dbw_fca.launch.py">
  <arg name="playback" value="$(var playback)" />
  <arg name="ulc" value="True" />
  <arg name="vehicle_ns" value="vehicle" />
  <arg name="can_ns" value="can_bus_dbw" />
  <arg name="ackermann_wheelbase" value="3.088" />
  <arg name="ackermann_track" value="1.73" />
  <arg name="steering_ratio" value="16.2" />
</include>

<!-- Start up device drivers and load URDF extrinsics calibration -->
<!-- <include file="$(find-pkg-share beliv_vehicle_interface)/launch/devices.launch.xml">
<arg name="playback" value="false" />
</include> -->

<!--Beliv Vehcile Interface-->
<node pkg="beliv_vehicle_interface" exec="beliv_veh_interface" output="screen">
</node>

</launch>
